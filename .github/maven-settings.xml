<settings xmlns="http://maven.apache.org/SETTINGS/1.3.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.3.0 https://maven.apache.org/xsd/settings-1.3.0.xsd">
    <interactiveMode>false</interactiveMode>
    <servers>
        <server>
            <id>sonatype</id>
            <username>${env.MAVEN_USERNAME}</username>
            <password>${env.MAVEN_PASSWORD}</password>
            <repositoryOrigins>
                <repositoryOrigin>https://ossrh-staging-api.central.sonatype.com</repositoryOrigin>
                <repositoryOrigin>https://central.sonatype.com</repositoryOrigin>
            </repositoryOrigins>
        </server>
        <server>
            <id>gpg.passphrase</id>
            <passphrase>${env.MAVEN_GPG_PASSPHRASE}</passphrase>
        </server>
    </servers>
</settings>
